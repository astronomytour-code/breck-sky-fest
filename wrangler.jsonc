{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breck-sky-fest",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "breckskyfest.com",
      "custom_domain": true
    },
    {
      "pattern": "www.breckskyfest.com/*",
      "zone_name": "breckskyfest.com"
    },
    {
      "pattern": "brecksky.com",
      "custom_domain": true
    },
    {
      "pattern": "www.brecksky.com/*",
      "zone_name": "brecksky.com"
    }
  ]
}
