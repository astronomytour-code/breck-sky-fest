{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breck-sky-fest",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "brecksky.com",
      "custom_domain": true
    },
    {
      "pattern": "breckskyfest.com",
      "custom_domain": true
    }
  ]
}
