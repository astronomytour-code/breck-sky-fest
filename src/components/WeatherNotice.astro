---
import { friscoWeather, mondayWeather, saturdayWeather } from '../data/festival';

interface Props {
  path: string;
}

const { path } = Astro.props;
const isOverview = ['/', '/program/', '/visit/'].includes(path);
const showFriday = isOverview || ['/program/frisco-historic-park-stargazing/', '/rsvp/frisco/'].includes(path);
const showSaturday = isOverview || ['/program/community-stargazing/', '/program/vip-stargazing-beaver-run/', '/rsvp/breck/'].includes(path);
const isMonday = ['/program/weather-backup-stargazing/', '/rsvp/monday/'].includes(path);
const showMonday = showSaturday || isMonday;
---

{(showFriday || showSaturday || showMonday) && (
  <aside class="weather-notice" aria-label="Stargazing weather update">
    <div class="wrap">
      <p class="weather-title">Stargazing weather update</p>
      {showFriday && <p><strong>Friday, November 27 · Frisco is going ahead.</strong> Join us at Frisco Historic Park from 5:30 to 7:30 PM MST. {friscoWeather} Look for our flags near the schoolhouse or gazebo.</p>}
      {showSaturday && <p><strong>Saturday, November 28 · Breckenridge stargazing is canceled.</strong> {saturdayWeather} This covers the free program at Quicksilver and VIP stargazing at Beaver Run.</p>}
      {showMonday && <p><strong>Monday, November 30 · Breckenridge backup night.</strong> {mondayWeather} {path !== '/rsvp/monday/' && <a class="text-link" href="/rsvp/monday/">Free Monday RSVP</a>}</p>}
      <p>Check this site and your RSVP or booking email before heading out.</p>
    </div>
  </aside>
)}

<style>
  .weather-notice {
    padding-block: 1rem;
    border-block-end: 3px solid var(--yellow);
    background: #fff2ce;
    color: var(--ink);
  }

  .weather-notice p {
    max-width: 75ch;
    font-size: 1rem;
  }

  .weather-notice p + p {
    margin-top: 0.35rem;
  }

  .weather-notice .weather-title {
    font-size: 1.125rem;
    font-weight: 800;
  }
</style>
