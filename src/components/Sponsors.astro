---
import Icon from './Icon.astro';
const { compact = false } = Astro.props;
---
<div class:list={['sponsor-grid', {compact}]}>
  <div class="sponsor sponsor-gold"><span class="sponsor-level">Gold sponsor</span><Icon name="stars" size={34}/><h3>TBA</h3><p>Our next chapter has room for you.</p><a href="/sponsors/#become-a-sponsor" class="text-link">Explore sponsorship <span aria-hidden="true">↗</span></a></div>
  <div class="sponsor sponsor-silver"><span class="sponsor-level">Silver sponsor</span><Icon name="mountain" size={34}/><h3>Town of<br/>Breckenridge</h3><a href="https://www.townofbreckenridge.com/" class="text-link">Visit the town website <span aria-hidden="true">↗</span></a></div>
  <div class="sponsor sponsor-bronze"><span class="sponsor-level">Bronze sponsor</span><img src="/images/astrotours-logo.webp" alt="AstroTours.org logo" width="84" height="84" loading="lazy"/><h3>AstroTours.org</h3><a href="https://www.astrotours.org/" class="text-link">Meet the astronomers <span aria-hidden="true">↗</span></a></div>
</div>
