---
const { compact = false } = Astro.props;
---
<div class:list={['sponsor-tiers', {compact}]}>
  <section class="sponsor-tier sponsor-intergalactic">
    <div class="tier-heading"><span>Intergalactic</span><small>Founding-level support</small></div>
    <div class="sponsor-row">
      <article class="tier-sponsor">
        <img class="town-logo" src="https://www.townofbreckenridge.com/home/showpublishedimage/6653/637211622745670000" alt="Town of Breckenridge logo" width="387" height="312" loading="lazy"/>
        <h3>Town of Breckenridge</h3>
        <p>Founding grant support for the first Breck Sky Fest.</p>
        <a href="https://www.townofbreckenridge.com/" target="_blank" rel="noopener noreferrer" class="text-link">Visit the town website <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="sponsor-tier sponsor-orbital">
    <div class="tier-heading"><span>Orbital</span><small>Community support</small></div>
    <div class="sponsor-row">
      <article class="tier-sponsor">
        <img class="partner-logo" src="/images/boec-logo.png" alt="Breckenridge Outdoor Education Center (BOEC) logo" width="583" height="207" loading="lazy"/>
        <h3>Breckenridge Outdoor Education Center (BOEC)</h3>
        <p>Accessible astronomy partner for the festival kickoff.</p>
        <a href="https://boec.org/" target="_blank" rel="noopener noreferrer" class="text-link">Visit BOEC <span aria-hidden="true">↗</span></a>
      </article>
      <article class="tier-sponsor">
        <img class="partner-logo historic-park-logo" src="/images/frisco-historic-park-logo.png" alt="Frisco Historic Park & Museum logo" width="620" height="176" loading="lazy"/>
        <h3>Frisco Historic Park &amp; Museum</h3>
        <p>Community host for November 27 stargazing.</p>
        <a href="https://www.townoffrisco.com/things-to-do/frisco-historic-park-museum/" target="_blank" rel="noopener noreferrer" class="text-link">Visit Frisco Historic Park <span aria-hidden="true">↗</span></a>
      </article>
      <article class="tier-sponsor">
        <img class="beaver-run-logo" src="/images/beaver-run-logo.png" alt="Beaver Run Resort & Conference Center logo" width="240" height="123" loading="lazy"/>
        <h3>Beaver Run Resort</h3>
        <p>Venue and hospitality partner.</p>
        <a href="https://beaverrun.com/" target="_blank" rel="noopener noreferrer" class="text-link">Visit Beaver Run <span aria-hidden="true">↗</span></a>
      </article>
      <article class="tier-sponsor">
        <img src="/images/colorado-stargazing-trail-mark.svg" alt="Colorado Stargazing Trail independent visitor guide mark" loading="lazy"/>
        <h3>ColoradoStargazingTrail.com</h3>
        <p>Promotional partner and independent Colorado stargazing guide.</p>
        <a href="https://www.coloradostargazingtrail.com/events/breckenridge-sky-festival-2026/" target="_blank" rel="noopener noreferrer" class="text-link">View the Breckenridge Sky Festival guide <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>
  <a class="organizer-credit" href="https://www.astrotours.org/" target="_blank" rel="noopener noreferrer"><img src="/images/astrotours-logo.webp" alt="AstroTours.org logo" width="48" height="48" loading="lazy"/><span>Organized and delivered by <strong>AstroTours.org</strong>.</span></a>
</div>

<style>
  .sponsor-tiers{display:grid;gap:26px}
  .sponsor-tier{--sponsor-color:var(--yellow);display:grid;grid-template-columns:190px minmax(0,1fr);gap:24px;padding:24px;border:1px solid var(--line);border-left:5px solid var(--sponsor-color);background:#faf7ef;border-radius:4px}
  .tier-heading{display:flex;flex-direction:column;justify-content:center;gap:5px}
  .tier-heading span{font-family:var(--display);font-size:1.8rem;font-weight:800;text-transform:uppercase;line-height:1}
  .tier-heading small{font-size:.67rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .sponsor-row{display:flex;flex-wrap:wrap;gap:18px;align-items:stretch}
  .tier-sponsor{flex:1 1 230px;min-width:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:20px 24px;border-left:1px solid var(--line)}
  .tier-sponsor img{object-fit:contain;margin-bottom:12px}
  .tier-sponsor h3{font-size:1.85rem;margin:6px 0 10px;max-width:100%;overflow-wrap:anywhere}
  .tier-sponsor p{font-size:.78rem;color:var(--muted);margin:0 0 12px;max-width:48ch}
  .tier-sponsor .text-link{font-size:.69rem}
  .sponsor-intergalactic{--sponsor-color:#c89a38}.sponsor-intergalactic .tier-sponsor>:global(svg){width:92px;height:92px;color:#c89a38;margin-bottom:6px}
  .sponsor-intergalactic .tier-sponsor img{width:110px;height:auto;max-height:110px}
  .sponsor-interstellar{--sponsor-color:#a0c7cc}.sponsor-interstellar .tier-sponsor img{width:82px;height:auto;max-height:82px}
  .sponsor-interplanetary{--sponsor-color:#e9afb5}.sponsor-interplanetary .tier-sponsor img{width:70px;height:70px;border-radius:50%}
  .sponsor-orbital{--sponsor-color:#bdcba6}.sponsor-orbital .tier-sponsor img{width:56px;height:56px}.sponsor-orbital .tier-sponsor>:global(svg){width:56px;height:56px;color:var(--ink);margin-bottom:12px}
  .sponsor-orbital .tier-sponsor img.beaver-run-logo{width:180px;height:auto;max-height:100px}
  .sponsor-tier .tier-sponsor img.partner-logo{width:220px;max-width:100%;height:auto;max-height:100px;border-radius:0}
  .organizer-credit{display:flex;align-items:center;justify-content:center;gap:14px;padding:12px;text-decoration:none;color:var(--ink);font-size:1rem}.organizer-credit img{width:48px;height:48px;object-fit:contain}
  .compact{gap:18px}.compact .sponsor-tier{padding:18px;grid-template-columns:165px minmax(0,1fr)}.compact .tier-sponsor{padding:14px 20px}.compact .tier-heading span{font-size:1.55rem}
  @media(max-width:760px){.sponsor-tier,.compact .sponsor-tier{grid-template-columns:1fr}.tier-sponsor{border-left:0;border-top:1px solid var(--line);padding-inline:0}.tier-heading{text-align:center}}
</style>
