---
import {experiences} from '../data/festival';
const slugs=['boec-school-program','accessible-astronomy-boec','astrotours-stargazing-beaver-run','wellness-under-the-sky','chelsea-kaiah-open-studio','sky-school','full-moon-hike-with-pride','reach-for-the-stars-storytime','bob-ross-style-painting-galaxies','frisco-historic-park-stargazing','night-sky-hike-fdrd','cosmic-creators-steam-saturday','vip-stargazing-beaver-run','community-stargazing','create-among-the-stars','weather-backup-stargazing'];
const dates=['11/11','11/11','11/18','11/21','11/22','11/23','11/24','11/25','11/25','11/27','11/27','11/28','11/28','11/28','11/29','11/30'];
---
<section class="section paper-section" id="schedule"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">A Summit County Dark Sky Celebration</span><h2>Festival schedule.</h2></div><p class="section-aside">November 2026 · All times are local Colorado time (MST). Use the event links for details, RSVPs, and tickets.</p></div><div class="festival-schedule">{slugs.map((slug,i)=>{const event=experiences.find(e=>e.slug===slug)!;return <article class="schedule-row"><div class="schedule-date"><strong>{dates[i]}</strong><span>{event.date?.split(',')[0]}</span></div><div><h3><a href={`/program/${slug}/`}>{event.title}</a></h3><p><strong>Time:</strong> {event.time}<br/><strong>Location:</strong> {event.venue}</p>{slug==='sky-school'&&<p><strong>8:00 AM–4:00 PM MST.</strong> Astronomy and hands-on science at Breckenridge Elementary and Upper Blue Elementary on November 23. For participating students only; not a public drop-in program.</p>}{slug==='community-stargazing'&&<p>Free · RSVP required for telescope viewing and weather updates. <a class="text-link" href="/program/vip-stargazing-beaver-run/">Explore the separate $57 VIP program at Beaver Run</a>.</p>}{slug==='boec-school-program'&&<p>BOEC homeschool students only. This 1 PM school session is not open to the public.</p>}{slug==='accessible-astronomy-boec'&&<p>Public evening stargazing with priority for guests with accessibility needs.</p>}{slug==='frisco-historic-park-stargazing'&&<p>Free · $0. Arrive and leave throughout the evening. Free RSVP required so we can plan enough equipment for everyone and send important weather updates.</p>}{slug==='wellness-under-the-sky'&&<p>Two 60-minute sessions hosted by Spirit Alchemy Studio. No experience necessary; yoga mats and props provided. $40 per person. Book your chosen session directly with the studio.</p>}{slug==='astrotours-stargazing-beaver-run'&&<p>A regular guided AstroTours stargazing tour during the festival month. From $57 per person · book through AstroTours.</p>}{slug==='vip-stargazing-beaver-run'&&<p>$57 per person · limited to 22 guests. Includes early access, tea and coffee service, and access to a warming area and fire. Book the November 28 Beaver Run tour directly through AstroTours. VIP program: 5:30–7:15 PM MST.</p>}{slug==='create-among-the-stars'&&<p>Choose canvas painting upstairs (24 painters maximum) or a glow-in-the-dark constellation mosaic downstairs (22 crafters maximum). $40 per participant/project, including supplies, equipment, instruction, and the house service charge. Breckenridge and Colorado taxes added at checkout. Arrive at noon for 12:15 PM instruction. Families choosing different options will split up. Book and pay online directly through Ready Paint Fire.</p>}{['reach-for-the-stars-storytime','cosmic-creators-steam-saturday','full-moon-hike-with-pride','night-sky-hike-fdrd','chelsea-kaiah-open-studio','bob-ross-style-painting-galaxies'].includes(slug)&&<p>{event.summary}</p>}{slug==='weather-backup-stargazing'&&<p>Weather backup for astronomy affected by poor weather during the main festival weekend. From $57 per person · reserve through AstroTours.</p>}</div><div class="schedule-actions"><a class="text-link" href={`/program/${slug}/`}>Event details</a>{event.past ? <span class="status-label">Past event</span> : event.ctaHref && <a class="button button-dark" href={event.ctaHref}>{event.ctaLabel}</a>}</div></article>})}</div></div></section>
