---
import {experiences} from '../data/festival';
const slugs=['boec-school-program','accessible-astronomy-boec','wellness-under-the-sky','sky-school','frisco-historic-park-stargazing','community-stargazing','vip-stargazing-beaver-run','weather-backup-stargazing'];
const dates=['11/11','11/11','11/21','11/23','11/27','11/28','11/28','11/30'];
---
<section class="section paper-section" id="schedule"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">A Summit County Dark Sky Celebration</span><h2>Festival schedule.</h2></div><p class="section-aside">November 2026 · All times are local Colorado time (MST). Confirmed event dates are below; remaining details are marked To Be Announced.</p></div><div class="festival-schedule">{slugs.map((slug,i)=>{const event=experiences.find(e=>e.slug===slug)!;return <article class="schedule-row"><div class="schedule-date"><strong>{dates[i]}</strong><span>{event.date?.split(',')[0]}</span></div><div><h3><a href={`/program/${slug}/`}>{event.title}</a></h3><p><strong>{slug==='community-stargazing'?'Times':'Time'}:</strong> {event.time}<br/><strong>Location:</strong> {event.venue}</p>{slug==='sky-school'&&<p><strong>Date confirmed · school-day times TBA.</strong> Astronomy and hands-on science at Breckenridge Elementary and Upper Blue Elementary on November 23. For participating students only; not a public drop-in program.</p>}{slug==='community-stargazing'&&<p>Daytime: Solar Astronomy · Evening: Stargazing. Check back as the full program is announced.</p>}{slug==='boec-school-program'&&<p>BOEC homeschool students only. This 1 PM school session is not open to the public.</p>}{slug==='accessible-astronomy-boec'&&<p>Public evening accessible stargazing, with priority for community members and families who need increased accessibility. RSVP and share your accessibility needs. We encourage most community members to choose Frisco on November 27 or the main Breck program on November 28.</p>}{slug==='frisco-historic-park-stargazing'&&<p>Free · $0. Arrive and leave throughout the evening. Free RSVP required so we can plan enough equipment for everyone and send important weather updates.</p>}{slug==='wellness-under-the-sky'&&<p>Two 60-minute sessions hosted by Spirit Alchemy Studio. No experience necessary; yoga mats and props provided. $40 per person. Book your chosen session directly with the studio.</p>}{slug==='vip-stargazing-beaver-run'&&<p>$57 per person · limited to 22 guests. Includes early access, tea and coffee service, and access to a warming area and fire. Book the November 28 Beaver Run tour directly through AstroTours. Early-access time TBA.</p>}{slug==='weather-backup-stargazing'&&<p>Weather backup for astronomy affected by poor weather during the main festival weekend.</p>}</div><div class="schedule-actions"><a class="text-link" href={`/program/${slug}/`}>Event details</a>{event.ctaHref&&<a class="button button-dark" href={event.ctaHref}>{event.ctaLabel}</a>}</div></article>})}</div></div></section>
