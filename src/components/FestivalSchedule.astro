---
import {experiences} from '../data/festival';
const slugs=['accessible-astronomy-boec','frisco-historic-park-stargazing','community-stargazing','weather-backup-stargazing'];
const dates=['11/11','11/27','11/28','11/30'];
---
<section class="section paper-section" id="schedule"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">A Summit County Dark Sky Celebration</span><h2>Festival schedule.</h2></div><p class="section-aside">November 2026 · All times are local Colorado time (MST). Confirmed dates are below; remaining details are marked To Be Announced.</p></div><div class="festival-schedule">{slugs.map((slug,i)=>{const event=experiences.find(e=>e.slug===slug)!;return <article class="schedule-row"><div class="schedule-date"><strong>{dates[i]}</strong><span>{event.date?.split(',')[0]}</span></div><div><h3><a href={`/program/${slug}/`}>{event.title}</a></h3><p><strong>{slug==='community-stargazing'?'Times':'Time'}:</strong> {event.time}<br/><strong>Location:</strong> {event.venue}</p>{slug==='community-stargazing'&&<p>Daytime: Solar Astronomy · Evening: Stargazing. Check back as the full program is announced.</p>}{slug==='accessible-astronomy-boec'&&<p>Accessible and inclusive astronomy with Breckenridge Outdoor Education Center (BOEC). Additional details coming soon.</p>}{slug==='frisco-historic-park-stargazing'&&<p>Free · $0. Arrive and leave throughout the evening. RSVP for attendance estimates and weather updates.</p>}{slug==='weather-backup-stargazing'&&<p>Weather backup for astronomy affected by poor weather during the main festival weekend.</p>}</div><div class="schedule-actions"><a class="text-link" href={`/program/${slug}/`}>Event details</a>{event.ctaHref&&<a class="button button-dark" href={event.ctaHref}>{event.ctaLabel}</a>}</div></article>})}</div></div></section>
