---
import {experiences} from '../data/festival';
const choices = [
  {slug:'weather-backup-stargazing', label:'Monday · November 30', action:'Free Monday RSVP', note:'Rescheduled main festival stargazing. Please RSVP for Monday even if you registered for Saturday.'},
].map(choice=>({...choice,event:experiences.find(event=>event.slug===choice.slug)!}));
---
<section class="section paper-section weekend-bookings" id="weekend-bookings" aria-labelledby="weekend-heading">
  <div class="wrap">
    <div class="section-heading">
      <div><span class="eyebrow">November 28–30, 2026</span><h2 id="weekend-heading">Join us Monday night.</h2></div>
      <p class="section-aside">Saturday’s free outdoor stargazing has been postponed to Monday. Saturday’s VIP session will not take place. Indoor programs remain on schedule. All times are MST.</p>
    </div>
    <div class="weekend-options">
      {choices.map(({event,label,action,note})=><article class="weekend-option">
        <span class="eyebrow">{label}</span>
        <h3><a href={`/program/${event.slug}/`}>{event.title}</a></h3>
        <p class="weekend-price">Free · RSVP required</p>
        <p><strong>{event.time}</strong><br/>{event.venue}</p>
        <p class="weekend-note">{note}</p>
        <a class="button button-dark" href={event.ctaHref}>{action}</a>
      </article>)}
    </div>
    <p class="weekend-after">Join <a class="text-link" href="/program/cosmic-creators-steam-saturday/">STEAM Saturday at Other Worlds</a> on November 28, 10 AM–1 PM. Indoor activities remain on schedule.</p>
    <p class="weekend-after">Keep exploring on Sunday, November 29: <a class="text-link" href="/program/create-among-the-stars/">Create Among the Stars at Ready Paint Fire!</a> Noon–3 PM · $40 plus taxes · Book directly with the studio.</p>
    <p class="weekend-weather">Outdoor programs depend on conditions. Dress warmly and check your event page or booking updates before heading out.</p>
  </div>
</section>

<style>
  .weekend-bookings{padding-block:52px}
  .weekend-options{display:grid;grid-template-columns:1fr;gap:22px}
  .weekend-option{display:flex;flex-direction:column;padding:27px;background:#faf7ef;border:1px solid var(--line);border-top:4px solid var(--green);border-radius:5px}
  .weekend-option .eyebrow{font-size:.65rem;margin-bottom:18px}
  .weekend-option h3{font-size:2rem;margin-bottom:17px}
  .weekend-option h3 a:hover{text-decoration:underline;text-underline-offset:4px}
  .weekend-option p{font-size:.86rem;margin-bottom:17px}
  .weekend-option .weekend-price{font-weight:700;color:var(--ink)}
  .weekend-option .weekend-note{font-size:.78rem;color:var(--muted)}
  .weekend-option .button{margin-top:auto;text-align:center;font-size:.8rem}
  .weekend-after{max-width:none;font-size:.9rem;margin-top:25px}
  .weekend-after .text-link{font-size:inherit}
  .weekend-weather{font-size:.78rem;color:var(--muted);max-width:none;margin-top:16px}
  @media(max-width:850px){.weekend-options{grid-template-columns:1fr}.weekend-option{padding:24px}.weekend-option .button{align-self:start}.weekend-bookings{padding-block:38px}}
</style>
