---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import {emailLink,festival} from '../data/festival';
const inquiries=[['Visiting the festival','Questions about attending, family activities, tickets, or access.','Visitor question'],['Partners & local businesses','A workshop, venue, vendor offering, or community event idea.','Partnership idea'],['Sponsorship','Financial or in-kind support for the first festival.','Sponsorship inquiry'],['Schools & youth groups','Tell us your group size, student ages, and what you are interested in.','School or youth group'],['Groups & private experiences','Client events, company outings, clubs, or a private stargazing session.','Group or private event']];
---
<Layout title="Contact | Breck Sky Fest" description="Contact Luke and the Breck Sky Fest team about attending, partnerships, sponsorship, school sessions, or private group experiences.">
  <PageIntro eyebrow="Questions & ideas welcome" title="Let’s talk sky." description="Planning a visit? Have something to bring to the festival? We’d like to hear from you." accent="green" icon="mail"/>
  <section class="section paper-section"><div class="wrap contact-layout"><div class="contact-box"><span class="eyebrow">Your festival contact</span><h2>Luke Huxley</h2><p>AstroTours.org<br/>Breck Sky Fest organizer</p><a class="contact-email" href={emailLink('Hello')}>{festival.email}</a><button type="button" class="copy-email text-link" hidden data-email={festival.email}>Copy email address <Icon name="arrow" size={18}/></button><span class="copy-status" aria-live="polite"></span><p>We prefer email as it keeps us organised.</p><div class="contact-status"><strong>Festival status</strong><p>November 2026.<br/>Final dates, venues, and registration details will be posted in October.</p></div></div><div><span class="eyebrow">Where can we help?</span><div class="inquiry-list">{inquiries.map(([title,copy,subject])=><a href={emailLink(subject)}><div><h3>{title}</h3><p>{copy}</p></div><Icon name="diagonal" size={24}/></a>)}</div><p class="small">Each link opens a draft in your email app. Send your message from there, or copy the address into your preferred email service.</p></div></div></section>
  <script>
    const copy=document.querySelector<HTMLButtonElement>('[data-email]');
    const status=document.querySelector<HTMLElement>('.copy-status');
    if(copy&&navigator.clipboard){copy.hidden=false;copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(copy.dataset.email||'');if(status)status.textContent='Email address copied.';}catch{if(status)status.textContent='Please select and copy the email address above.';}});}
  </script>
</Layout>
