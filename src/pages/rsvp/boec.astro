---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { boecStargazingVenue } from '../../data/festival';
---
<Layout title="BOEC Accessible Stargazing RSVP Closed | Breck Sky Fest" description="The November 11 accessible stargazing RSVP is closed. Find upcoming free stargazing in Breckenridge and Frisco." noindex>
  <PageIntro eyebrow="November 11 · Past event" title="BOEC stargazing registration is closed." description={`Accessible stargazing with BOEC · November 11, 2026 · ${boecStargazingVenue}`} icon="stars"/>
  <section class="section paper-section"><div class="wrap">
    <p>Join us for another free stargazing night during Breck Sky Fest.</p>
    <div class="actions">
      <a class="button button-dark" href="/rsvp/frisco/">Frisco Historic Park · November 27</a>
      <a class="button button-dark" href="/rsvp/breck/">Breckenridge Ski Resort · November 28</a>
    </div>
    <p><a class="text-link" href="/program/accessible-astronomy-boec/">View BOEC event details</a></p>
  </div></section>
</Layout>
