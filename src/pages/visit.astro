---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Updates from '../components/Updates.astro';
import Icon from '../components/Icon.astro';
import {faqs,emailLink} from '../data/festival';
---
<Layout title="Plan Your Visit | Breck Sky Fest" description="Plan for Breck Sky Fest with family information, clothing advice, registration status, accessibility, weather, and official Breckenridge travel resources.">
  <PageIntro eyebrow="Your festival field guide" title="Pack your curiosity. And a warm coat." description="A little preparation makes a mountain evening much more enjoyable. Find venues, registration links, and tips for an outdoor November program." icon="mountain" accent="blue"/>
  <section class="section paper-section" id="dates"><div class="wrap"><div class="planning-grid"><div class="planning-card"><Icon name="clock" size={30}/><span class="eyebrow">When</span><h2>November 2026</h2><p>November 11–30. The main weekend is November 27–28, with a November 30 weather backup at Beaver Run Resort.</p></div><div class="planning-card"><Icon name="pin" size={30}/><span class="eyebrow">Where</span><h2>Breckenridge &amp; Frisco</h2><p>Free stargazing is at Frisco Historic Park on November 27 and near the Quicksilver chair base at Breckenridge Ski Resort on November 28. VIP stargazing is at Beaver Run Resort on November 28.</p></div><div class="planning-card"><Icon name="ticket" size={30}/><span class="eyebrow">Registration</span><h2>Free stargazing RSVPs</h2><p><a class="text-link" href="/rsvp/frisco/">Frisco · November 27</a><br/><a class="text-link" href="/rsvp/breck/">Breckenridge · November 28</a></p></div></div><div class="notice"><Icon name="clock" size={26}/><div><strong>Before you book around an event</strong><p>Check the <a class="text-link" href="/program/#schedule">festival schedule</a> for start times, locations, and booking links.</p></div></div></div></section>
  <section class="section paper-section visit-prep"><div class="wrap feature-split"><div><span class="eyebrow">Family planning</span><h2>Make room for<br/>discoveries.</h2><p>Daytime science and community telescope viewing are at the heart of the family program. Check the schedule for activities that suit your children’s ages, attention spans, and bedtime.</p><ul class="check-list"><li><Icon name="stars" size={18}/>Children stay with their accompanying adult.</li><li><Icon name="stars" size={18}/>Check each event for age guidance and session length.</li><li><Icon name="stars" size={18}/>Ask the host about toilets, seating, or places to warm up.</li><li><Icon name="stars" size={18}/>No telescope or astronomy background needed for the main observing sessions.</li></ul><a class="text-link" href="/program/">Browse the festival schedule <Icon name="arrow" size={18}/></a></div><div class="packing-card"><span class="eyebrow">A November night’s packing list</span><h3>Warm from<br/>head to toe.</h3><ul><li>Warm coat and insulating layers</li><li>Hat, gloves, and warm socks</li><li>Sturdy footwear for possible snow or ice</li><li>A thermos, water, and a snack</li><li>Hand warmers, if you have them</li><li>A dim red light for observing sessions</li></ul><p>Standing still gets chilly. Plan for breaks, and keep bright phone screens and flashlights away from telescope viewing areas.</p></div></div></section>
  <section class="section dark-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">Getting here & getting around</span><h2>A good visit<br/>starts with a little planning.</h2></div><p class="section-aside">Check your event page or booking confirmation for arrival details.</p></div><div class="resource-grid"><a href="https://gobreck.com/" target="_blank" rel="noopener noreferrer" class="resource-card"><span>Official visitor guide</span><h3>Explore Breckenridge</h3><p>Find places to stay, things to do, and town travel information.</p><Icon name="diagonal" size={26}/></a><a href="https://www.breckfreeride.com/" target="_blank" rel="noopener noreferrer" class="resource-card"><span>Local public transport</span><h3>Breck Free Ride</h3><p>Check current routes and operating times.</p><Icon name="diagonal" size={26}/></a><a href="https://www.cotrip.org/" target="_blank" rel="noopener noreferrer" class="resource-card"><span>Before you drive</span><h3>Colorado road conditions</h3><p>Check current road conditions and travel alerts with COtrip.</p><Icon name="diagonal" size={26}/></a></div></div></section>
  <section class="section paper-section" id="accessibility"><div class="wrap info-grid"><div><span class="eyebrow">Access & comfort</span><h2>Let’s plan for<br/>your visit.</h2><p>Access varies by venue. Check your event page and contact the host about step-free routes, surfaces, seating, restrooms, or telescope access.</p><p>Tell us what would help you or your family take part.</p><a class="text-link" href={emailLink('Access question')}>Ask an access question <Icon name="arrow" size={18}/></a></div><div><span class="eyebrow">Weather & changes</span><h2>The sky has<br/>a say, too.</h2><p>Clouds affect telescope viewing, and snow or wind can affect outdoor plans. November 30 at Beaver Run Resort is the festival’s weather backup for main-weekend astronomy. RSVP for free stargazing in Frisco or Breckenridge so we can contact you about weather changes.</p><p>For ticketed events, check the host’s booking information for weather updates and refund terms.</p><a class="text-link" href="/contact/">Contact the festival <Icon name="arrow" size={18}/></a></div></div></section>
  <section class="section paper-section faq-preview" id="questions"><div class="wrap faq-split"><div><span class="eyebrow">Good to know</span><h2>Your questions,<br/>answered.</h2><p>Something else on your mind?</p><a class="text-link" href="/contact/">Ask us <Icon name="arrow" size={18}/></a></div><div class="faq-list">{faqs.map(faq=><details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
  <Updates/>
</Layout>
