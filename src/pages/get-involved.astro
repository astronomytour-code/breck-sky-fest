---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import {emailLink} from '../data/festival';
const opportunities=[
  {id:'artists',label:'Art & creativity',title:'Lead a workshop. Share your craft.',copy:'Artists, studios, galleries, and makers can propose a sky-inspired workshop, demonstration, or display. An existing class could become a special festival session.',example:'Artist workshop · artist and medium TBA',link:'/program/artist-workshop/',subject:'Artist or workshop idea',icon:'spark',accent:'pink'},
  {id:'science',label:'Science & stories',title:'Bring a telescope or a good question.',copy:'Astronomers, researchers, museums, clubs, photographers, and educators can help with observing, talks, demonstrations, and hands-on science.',example:'Space talks & sky stories · speakers TBA',link:'/program/talks-and-stories/',subject:'Science or astronomy partner',icon:'stars',accent:'blue'},
  {id:'venues',label:'Venues & hospitality',title:'Give part of the festival a home.',copy:'A community room, courtyard, gallery, hotel, or mountain venue could host a session. Tell us about your space, capacity, access, and indoor or outdoor options.',example:'Signature mountain evening · venue TBA',link:'/program/mountain-stargazing/',subject:'Venue or hospitality partnership',icon:'mountain',accent:'green'},
  {id:'vendors',label:'Food, drinks & local businesses',title:'Make a festival stop worth lingering at.',copy:'Cafés, restaurants, food vendors, and local shops can propose a pop-up, warm-drink stop, special menu, or sky-themed offering connected to the weekend.',example:'Food & warm drinks · vendors TBA',link:'/program/food-and-warm-drinks/',subject:'Vendor or local business idea',icon:'cup',accent:'orange'},
  {id:'wellness',label:'Wellness & community',title:'Bring your own way of looking up.',copy:'Yoga teachers, sound practitioners, community groups, and other local hosts can propose a session or adapt something they already run for the festival.',example:'Yoga, sound & wellbeing · practitioner TBA',link:'/program/wellness-under-the-sky/',subject:'Community or wellness event',icon:'moon',accent:'purple'},
  {id:'schools',label:'Schools & youth groups',title:'Make space for student discovery.',copy:'Teachers and group leaders can help shape Breck Sky School. Tell us your students’ ages, group size, curriculum interests, and any transport or access needs.',example:'Breck Sky School · group sessions TBA',link:'/program/sky-school/',subject:'School or youth group participation',icon:'sun',accent:'yellow'},
];
---
<Layout title="Get Involved | Breck Sky Fest" description="Bring a workshop, venue, telescope, food offering, school group, or community event to the first Breck Sky Fest. Partner ideas and sponsorship inquiries welcome.">
  <PageIntro eyebrow="Help make the first edition" title="Our town. Our community. Everyone’s sky." description="Breck Sky Fest is inviting local businesses, artists, educators, venues, and community groups to help shape a festival that feels like Breckenridge." accent="pink" icon="spark"/>
  <section class="section paper-section"><div class="wrap"><div class="intro-split"><div><span class="eyebrow">A place for what you do</span><h2>Start with<br/>an idea.</h2></div><div><p class="large">Host a new event, bring an activity to the program, or give something you already run a festival twist.</p><p>The astronomy program provides a starting point. The wider festival can grow through local workshops, food, creative projects, and community events. We are talking with potential partners now; arrangements will be agreed individually.</p></div></div><div class="partner-opportunities">{opportunities.map(o=><article id={o.id} class:list={['partner-opportunity',`accent-${o.accent}`]}><div class="opportunity-top"><Icon name={o.icon} size={36}/><span class="eyebrow">{o.label}</span></div><h3>{o.title}</h3><p>{o.copy}</p><a class="opportunity-example" href={o.link}>{o.example}<Icon name="diagonal" size={18}/></a><a class="text-link" href={emailLink(o.subject)}>Start a conversation <Icon name="arrow" size={18}/></a></article>)}</div></div></section>
  <section class="section dark-section"><div class="wrap intro-split"><div><span class="eyebrow">From an idea to the program</span><h2>Let’s work<br/>out the details.</h2></div><ol class="steps-list"><li><span>01</span><div><h3>Tell us what you have in mind.</h3><p>A short email is enough: who you are, the idea, who it suits, and what you would need.</p></div></li><li><span>02</span><div><h3>Find the right fit.</h3><p>We can discuss timing, venue, capacity, access, staffing, costs, and promotion together.</p></div></li><li><span>03</span><div><h3>Confirm it, then share it.</h3><p>Once agreed, the event can have its own festival listing with the details guests need.</p></div></li></ol></div></section>
  <section class="section paper-section" id="groups"><div class="wrap info-grid"><div><span class="eyebrow">Groups & private experiences</span><h2>Coming with<br/>a whole crew?</h2><p>Planning a client event, company retreat, club visit, or a private evening during the festival period? Tell us your group size, preferred timing, and what you have in mind.</p><p>Private arrangements, capacity, and pricing will be discussed separately. Festival group bookings are not open yet.</p><a class="button button-dark" href={emailLink('Group or private event inquiry','Hi Luke,\n\nI would like to discuss a group or private experience connected with Breck Sky Fest.\n\nGroup or organization:\nApproximate group size:\nPreferred dates or flexibility:\nWhat we have in mind:\n')}>Ask about a group experience <Icon name="arrow" size={20}/></a></div><div><span class="eyebrow">Support the festival</span><h2>Help make<br/>more possible.</h2><p>Sponsorship can help with student access, community astronomy, materials, equipment, and the practical work of bringing people together.</p><p>Financial and in-kind support are both welcome to discuss. Explore Orbital, Interplanetary, Interstellar, and Intergalactic sponsorship opportunities.</p><a class="button button-dark" href="/sponsors/">Explore sponsorship <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="simple-cta"><div class="wrap"><div><h2>Don’t see your idea here?</h2><p>Tell us anyway. This is a good time to help shape the festival.</p></div><a class="button" href={emailLink('An idea for the festival')}>Share your idea <Icon name="arrow" size={20}/></a></div></section>
</Layout>
