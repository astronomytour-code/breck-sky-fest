---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import {emailLink} from '../data/festival';
const opportunities=[
  {id:'artists',label:'Art & creativity',title:'Lead a workshop. Share your craft.',copy:'Artists, studios, galleries, and makers can propose a sky-inspired workshop, demonstration, or display. An existing class could become a special festival session.',example:'Create Among the Stars at Ready Paint Fire!',link:'/program/create-among-the-stars/',subject:'Artist or workshop idea',icon:'spark',accent:'pink'},
  {id:'science',label:'Science & stories',title:'Bring a telescope or a good question.',copy:'Astronomers, researchers, museums, clubs, photographers, and educators can help with observing, talks, or a hands-on science station. Dark-sky and outdoor groups can contribute ideas about lighting, wildlife, and caring for the night.',example:'STEAM Saturday at Other Worlds',link:'/program/cosmic-creators-steam-saturday/',subject:'Science or astronomy partner',icon:'stars',accent:'blue'},
  {id:'venues',label:'Venues & hospitality',title:'Give part of the festival a home.',copy:'A community room, courtyard, gallery, hotel, or mountain venue could host a session. Tell us about your space, capacity, access, and indoor or outdoor options.',example:'VIP Stargazing at Beaver Run',link:'/program/vip-stargazing-beaver-run/',subject:'Venue or hospitality partnership',icon:'mountain',accent:'green'},
  {id:'vendors',label:'Food, drinks & local businesses',title:'Make a festival stop worth lingering at.',copy:'Cafés, restaurants, food vendors, and local shops can propose a pop-up, warm-drink stop, special menu, or sky-themed offering connected to the festival period.',example:'Community partnership and sponsorship',link:'/sponsors/',subject:'Vendor or local business idea',icon:'cup',accent:'orange'},
  {id:'wellness',label:'Wellness & community',title:'Bring your own way of looking up.',copy:'Yoga teachers, sound practitioners, community groups, and other local hosts can propose a session or adapt something they already run for the festival.',example:'Celestial Sound Journey at Spirit Alchemy Studio',link:'/program/wellness-under-the-sky/',subject:'Community or wellness event',icon:'moon',accent:'purple'},
  {id:'film',label:'Film & conversation',title:'Bring space to the screen.',copy:'A proposed film screening could explore astronomy, dark skies, or science fiction. Film programmers, venues, and speakers can help shape a suitable event, subject to screening rights and other arrangements.',example:'Contact the festival about a screening',link:emailLink('Film or screening idea'),subject:'Film or screening idea',icon:'stars',accent:'blue'},
  {id:'access',label:'Accessible participation',title:'Help more people take part.',copy:'Outdoor recreation and access organizations can help us assess observing setups, seating, routes, and ways to welcome guests with different needs. Access arrangements will be published per event once agreed.',example:'Festival access information',link:'/visit/#accessibility',subject:'Accessible participation idea',icon:'stars',accent:'green'},
  {id:'schools',label:'Schools & youth groups',title:'Make space for student discovery.',copy:'Breck Sky School brings astronomy and hands-on science to Breckenridge Elementary and Upper Blue Elementary. Teachers can tell us about student ages, group size, available space, access needs, and school-day timing.',example:'Breck Sky School · November 23',link:'/program/sky-school/',subject:'School or youth group participation',icon:'sun',accent:'yellow'},
];
---
<Layout title="Get Involved | Breck Sky Fest" description="Bring a workshop, venue, telescope, food offering, school group, or community event to the first Breck Sky Fest. Partner ideas and sponsorship inquiries welcome.">
  <PageIntro eyebrow="Help make the first edition" title="Our town. Our community. Everyone’s sky." description="Breck Sky Fest is inviting businesses, artists, educators, venues, and community groups in Breckenridge and across Summit County to help shape a festival with Breckenridge at its heart." accent="pink" icon="spark"/>
  <section class="section paper-section"><div class="wrap"><div class="intro-split"><div><span class="eyebrow">A place for what you do</span><h2>Start with<br/>an idea.</h2></div><div><p class="large">Host a new event, bring an activity to the program, or give something you already run a festival twist.</p><p>See what local partners are doing this November, and get in touch about a future collaboration.</p></div></div><div class="partner-opportunities">{opportunities.map(o=><article id={o.id} class:list={['partner-opportunity',`accent-${o.accent}`]}><div class="opportunity-top"><Icon name={o.icon} size={36}/><span class="eyebrow">{o.label}</span></div><h3>{o.title}</h3><p>{o.copy}</p><a class="opportunity-example" href={o.link}>{o.example}<Icon name="diagonal" size={18}/></a><a class="text-link" href={emailLink(o.subject)}>Start a conversation <Icon name="arrow" size={18}/></a></article>)}</div></div></section>
  <section class="section dark-section"><div class="wrap intro-split"><div><span class="eyebrow">From an idea to the program</span><h2>Let’s work<br/>out the details.</h2></div><ol class="steps-list"><li><span>01</span><div><h3>Tell us what you have in mind.</h3><p>A short email is enough: who you are, the idea, who it suits, and what you would need.</p></div></li><li><span>02</span><div><h3>Find the right fit.</h3><p>We can discuss timing, venue, capacity, access, staffing, costs, and promotion together.</p></div></li><li><span>03</span><div><h3>Confirm it, then share it.</h3><p>Once agreed, the event can have its own festival listing with the details guests need.</p></div></li></ol></div></section>
  <section class="section paper-section" id="groups"><div class="wrap info-grid"><div><span class="eyebrow">Groups & private experiences</span><h2>Coming with<br/>a whole crew?</h2><p>Planning a client event, company retreat, club visit, or a private evening during the festival period? Tell us your group size, preferred timing, and what you have in mind.</p><p>Contact us for availability, capacity, and pricing.</p><a class="button button-dark" href={emailLink('Group or private event inquiry','Hi Luke,\n\nI would like to discuss a group or private experience connected with Breck Sky Fest.\n\nGroup or organization:\nApproximate group size:\nPreferred dates or flexibility:\nWhat we have in mind:\n')}>Ask about a group experience <Icon name="arrow" size={20}/></a></div><div><span class="eyebrow">Support the festival</span><h2>Help make<br/>more possible.</h2><p>Sponsorship can help with student access, community astronomy, materials, equipment, and the practical work of bringing people together.</p><p>Financial and in-kind support are both welcome to discuss. Explore Orbital, Interplanetary, Interstellar, and Intergalactic sponsorship opportunities. Orbital recognition also welcomes approved community partners contributing hosting, services, outreach, or collaboration.</p><a class="button button-dark" href="/sponsors/">Explore sponsorship <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="simple-cta"><div class="wrap"><div><h2>Don’t see your idea here?</h2><p>Get in touch about your idea for a future program.</p></div><a class="button" href={emailLink('An idea for the festival')}>Share your idea <Icon name="arrow" size={20}/></a></div></section>
</Layout>
