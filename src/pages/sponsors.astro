---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Sponsors from '../components/Sponsors.astro';
import Icon from '../components/Icon.astro';
import {emailLink} from '../data/festival';
---
<Layout title="Sponsors & Sponsorship | Breck Sky Fest" description="Meet Breck Sky Fest’s Gold, Silver, and Bronze sponsor tiers, including the Town of Breckenridge and AstroTours.org, and explore support for the first festival.">
  <PageIntro eyebrow="Thank you for helping Breck look up" title="A shared sky. A community effort." description="Support for the first Breck Sky Fest helps turn a good idea into telescope time, student discoveries, and a weekend the community can enjoy." icon="stars"/>
  <section class="section paper-section"><div class="wrap"><span class="eyebrow">2026 festival sponsors</span><h2 class="sponsors-heading">Our supporters.</h2><Sponsors/></div></section>
  <section class="section dark-section" id="become-a-sponsor"><div class="wrap intro-split"><div><span class="eyebrow">Become a sponsor</span><h2>Help someone<br/>see something new.</h2></div><div><p class="large">A first view of Saturn. A science question that stays with a student. A family spending an evening together outside.</p><p>We’re looking for sponsors who want to help build those experiences in Breckenridge. Gold, Silver, and Bronze support can be discussed around the part of the festival you would like to help make possible.</p><a class="button" href={emailLink('Sponsorship inquiry','Hi Luke,\n\nI would like to discuss sponsoring Breck Sky Fest.\n\nBusiness or organization:\nArea of interest or preferred tier:\nFinancial or in-kind support we could offer:\nQuestions:\n')}>Talk sponsorship <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="section paper-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">Where support can help</span><h2>Choose a part<br/>of the story.</h2></div><p class="section-aside">Contributions and recognition will be agreed with each sponsor. We can discuss a financial contribution, useful equipment, materials, hospitality, or services.</p></div><div class="support-grid"><div><span>01 / Student access</span><h3>More science in a school day.</h3><p>Help with learning materials, astronomy sessions, or transport for participating school and youth groups.</p></div><div><span>02 / Community astronomy</span><h3>Keep telescope time within reach.</h3><p>Support the astronomers, equipment, and event costs behind planned free community activities.</p></div><div><span>03 / Creative experiences</span><h3>Make room for local ideas.</h3><p>Help a workshop, demonstration, photography session, or artist-led activity become part of the program.</p></div><div><span>04 / A welcoming visit</span><h3>Take care of the practical things.</h3><p>Support suitable spaces, seating, wayfinding, warmth, and other needs as venues are confirmed.</p></div></div><div class="inline-callout"><div><h2>Let’s find a useful fit.</h2><p>Tell us about your organization, what interests you, and the support you have in mind. We can discuss scope, recognition, and next steps together.</p></div><a class="button button-dark" href={emailLink('Sponsorship inquiry')}>Contact the festival <Icon name="arrow" size={20}/></a></div></div></section>
</Layout>
