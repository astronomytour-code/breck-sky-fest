---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
---
<Layout title="RSVP Submissions | Breck Sky Fest" noindex>
<PageIntro eyebrow="Festival team" title="Festival RSVP submissions." description="Enter your private access key to view attendance and download submissions for weather updates and reporting." icon="stars"/>
<section class="section paper-section"><div class="wrap"><form class="rsvp-form" id="admin-login"><label for="admin-key">Private access key</label><input id="admin-key" type="password" autocomplete="current-password" required/><button class="button button-dark" type="submit">View submissions</button><p class="form-status" role="status"></p></form><div id="admin-results" class="admin-results" hidden><p id="attendance-total"></p><button class="button button-dark" id="export-csv" type="button">Download CSV</button><button class="button button-outline" id="admin-logout" type="button">Lock submissions</button><table><thead><tr><th>Event</th><th>Submitted (UTC)</th><th>Name</th><th>Email</th><th>People</th><th>Accessibility needs</th><th>Reference</th></tr></thead><tbody id="rsvp-rows"></tbody></table></div></div></section>
<script>
let records:Array<{created_at:string;name:string;email:string;people:number;id:string;event:string;accessibility:string}>=[];
const form=document.querySelector<HTMLFormElement>('#admin-login')!;
form.addEventListener('submit',async(event)=>{event.preventDefault();const key=document.querySelector<HTMLInputElement>('#admin-key')!;const status=form.querySelector<HTMLElement>('.form-status')!;status.textContent='Loading…';try{const response=await fetch('/api/admin/rsvps',{headers:{Authorization:`Bearer ${key.value}`}});const data=await response.json();if(!response.ok)throw new Error(data.error||'Could not load submissions.');records=data.rows;const body=document.getElementById('rsvp-rows')!;body.replaceChildren();records.forEach(record=>{const row=document.createElement('tr');[record.event,record.created_at,record.name,record.email,String(record.people),record.accessibility||'',record.id].forEach(value=>{const cell=document.createElement('td');cell.textContent=value;row.appendChild(cell);});body.appendChild(row);});document.getElementById('attendance-total')!.textContent=`${records.length} RSVPs · ${records.reduce((total,r)=>total+r.people,0)} people`;form.hidden=true;key.value='';document.getElementById('admin-results')!.hidden=false;status.textContent='';}catch(error){status.textContent=error instanceof Error?error.message:'Could not load submissions.';}});
document.getElementById('export-csv')?.addEventListener('click',()=>{const safe=(value:unknown)=>{let s=String(value);if(/^[=+@\-\t\r]/.test(s))s="'"+s;return '"'+s.replaceAll('"','""')+'"';};const csv=[['Event','Submitted UTC','Name','Email','People','Accessibility needs','Reference'],...records.map(r=>[r.event,r.created_at,r.name,r.email,r.people,r.accessibility||'',r.id])].map(row=>row.map(safe).join(',')).join('\r\n');const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download='festival-rsvps-2026.csv';link.click();URL.revokeObjectURL(url);});
document.getElementById('admin-logout')?.addEventListener('click',()=>{records=[];document.getElementById('rsvp-rows')!.replaceChildren();document.getElementById('admin-results')!.hidden=true;form.hidden=false;});
</script>
</Layout>
