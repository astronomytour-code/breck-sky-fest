---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import Sponsors from '../components/Sponsors.astro';
import Updates from '../components/Updates.astro';
import {experiences,faqs} from '../data/festival';
---
<Layout>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy"><span class="eyebrow"><span class="tiny-star">✦</span> A new festival. A shared sky.</span><h1>BRECKENRIDGE<br/><span>SKY FESTIVAL</span><span class="hero-period">.</span></h1><p class="hero-tagline">A weekend for looking up.</p><p class="hero-description">Telescopes. Art. Hands-on science. A new astronomy and dark-sky festival for curious people of all ages in Breckenridge, Colorado.</p><div class="actions"><a href="/program/" class="button">Explore the program <Icon name="arrow" size={20}/></a><a href="/visit/" class="quiet-link">Plan your visit <span aria-hidden="true">↗</span></a></div><p class="hero-status"><span class="status-dot"></span> November 2026 · Final details posted in October</p></div>
      <figure class="hero-figure"><div class="hero-photo"><img src="/images/mountain-stars.webp" alt="A telescope silhouetted against the stars and mountains at an AstroTours observing session" width="1280" height="853" fetchpriority="high"/><span class="photo-coordinate">A little closer to the universe.</span><div class="hero-photo-bottom"><span>Sunlight<br/>to starlight.</span><Icon name="stars" size={46}/></div></div><div class="festival-seal"><span>First edition</span><strong>2026</strong><span>Breckenridge, CO</span></div></figure>
    </div>
  </section>
  <div class="festival-strip" aria-label="Festival themes"><div class="wrap"><span>Telescopes</span><b aria-hidden="true">✦</b><span>Science</span><b aria-hidden="true">✦</b><span>Art & ideas</span><b aria-hidden="true">✦</b><span>Mountain skies</span><b aria-hidden="true">✦</b><span>Good company</span></div></div>
  <section class="section paper-section home-intro"><div class="wrap intro-split"><div><span class="eyebrow">Welcome to Breckenridge Sky Festival</span><h2>Bring your people.<br/>Bring your curiosity.</h2></div><div class="intro-body"><p class="large">Look through a telescope, try the science, and spend some time under Breckenridge’s sky.</p><p>We’re bringing astronomy, hands-on learning, and local creativity together during the festival period. The program is taking shape around student sessions, community stargazing, daytime activities, and a signature high-country evening.</p><a class="text-link" href="/about/">Meet the festival <Icon name="arrow" size={18}/></a></div></div></section>
  <section class="section paper-section program-preview" id="events"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">From sunshine to starlight</span><h2>Find your<br/>sky time.</h2></div><div class="section-aside"><p>A first look at what we’re planning. Final dates, venues, times, and access details will be posted in October.</p><a class="text-link" href="/program/">Explore all experiences <Icon name="arrow" size={18}/></a></div></div><div class="experience-grid home-events">{experiences.slice(0,3).map(event=><ExperienceCard event={event}/>)}</div><p class="photo-note">Program images show previous astronomy and science sessions. Final festival venues and arrangements are still being confirmed.</p></div></section>
  <section class="section community-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">More ways to join in</span><h2>A whole town<br/>of possibilities.</h2></div><div class="section-aside"><p>Local people will help make this festival its own. These proposed additions have room for artists, teachers, makers, and businesses to shape them.</p></div></div><div class="possibilities-grid">{[experiences[4],experiences[5],experiences[6],experiences[8]].map(event=><a class:list={['possibility',`accent-${event.accent}`]} href={`/program/${event.slug}/`}><Icon name={event.icon} size={38}/><span class="status-label">{event.status}</span><h3>{event.title}</h3><span class="possibility-arrow" aria-hidden="true">↗</span></a>)}</div><div class="section-bottom"><p>Have an idea for a workshop, pop-up, talk, or local event?</p><a class="button button-outline" href="/get-involved/">Be part of the festival <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="section paper-section family-section" id="visit"><div class="wrap feature-split"><figure class="family-photo"><img src="/images/family-telescope.webp" alt="A family taking turns at a large telescope at dusk during an AstroTours program" width="1280" height="960" loading="lazy"/><figcaption>Real skies. Real curiosity. An AstroTours family session.</figcaption><span class="photo-sticker">Small world.<br/>Big universe.</span></figure><div><span class="eyebrow">Make a family adventure of it</span><h2>New to stargazing?<br/>Start here.</h2><p>The festival is being planned with first-time stargazers in mind. Start with daytime science, try something creative, and come back for a look through a telescope after dark.</p><ul class="feature-list"><li><Icon name="sun"/>Daytime activities for curious kids and grown-ups</li><li><Icon name="stars"/>Astronomers who welcome every question</li><li><Icon name="ticket"/>Free community activities planned alongside ticketed events</li></ul><a href="/visit/" class="button button-dark">Start planning your visit <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="visitor-ribbon"><div class="wrap"><div><span>01 / When</span><strong>November 2026</strong><p>Exact dates coming soon</p></div><div><span>02 / Where</span><strong>Breckenridge, CO</strong><p>Venues & festival map TBA</p></div><div><span>03 / Registration</span><strong>Coming soon</strong><p>Free community activities planned alongside ticketed events</p></div><a href="/visit/">The practical stuff <Icon name="arrow" size={25}/></a></div></section>
  <section class="section paper-section" id="partners"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">Helping Breck look up</span><h2>Our sponsors.</h2></div><a class="text-link" href="/sponsors/">Meet the supporters <Icon name="arrow" size={18}/></a></div><Sponsors compact/></div></section>
  <section class="section faq-preview paper-section"><div class="wrap faq-split"><div><span class="eyebrow">Before you pack the cocoa</span><h2>A few good<br/>questions.</h2><a class="text-link" href="/visit/#questions">All visitor questions <Icon name="arrow" size={18}/></a></div><div class="faq-list">{[faqs[0],faqs[1],faqs[2],faqs[5]].map(faq=><details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
  <Updates/>
</Layout>
