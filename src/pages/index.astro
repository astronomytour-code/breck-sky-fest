---
const title = 'Breck Sky Fest';
const description = "Breckenridge's astronomy and dark-sky festival.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #080b16; color: #f5f7ff; }
      main { width: min(90%, 760px); text-align: center; padding: 4rem 1rem; }
      h1 { font-size: clamp(3rem, 10vw, 6rem); margin: 0 0 1rem; letter-spacing: -0.04em; }
      p { font-size: 1.25rem; line-height: 1.6; color: #c8cee0; }
    </style>
  </head>
  <body>
    <main>
      <h1>Breck Sky Fest</h1>
      <p>Breckenridge's astronomy and dark-sky festival.</p>
    </main>
  </body>
</html>
