---
import FestivalSchedule from '../components/FestivalSchedule.astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import Sponsors from '../components/Sponsors.astro';
import Updates from '../components/Updates.astro';
import {experiences,faqs} from '../data/festival';
---
<Layout>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy"><span class="eyebrow"><span class="tiny-star">✦</span> A new festival. A shared sky.</span><h1>BRECKENRIDGE<br/><span>SKY FESTIVAL</span><span class="hero-period">.</span></h1><p class="hero-tagline">Keeping Summit County looking up.</p><p class="hero-description">Telescopes. Art. Hands-on science. A new astronomy and dark-sky festival for curious people of all ages in Breckenridge, Colorado.</p><div class="actions"><a href="/program/" class="button">Explore the program <Icon name="arrow" size={20}/></a><a href="/visit/" class="quiet-link">Plan your visit <span aria-hidden="true">↗</span></a></div><p class="hero-status"><span class="status-dot"></span> November 11–30, 2026 · Main weekend November 27–28</p></div>
      <figure class="hero-figure"><div class="hero-photo"><img src="/images/mountain-stars.webp" alt="A telescope silhouetted against the stars and mountains at an AstroTours observing session" width="1280" height="853" fetchpriority="high"/><span class="photo-coordinate">A little closer to the universe.</span><div class="hero-photo-bottom"><span>Sunlight<br/>to starlight.</span><Icon name="stars" size={46}/></div></div><div class="festival-seal"><span>Blasting off</span><strong>2026</strong><span>Breckenridge, CO</span></div></figure>
    </div>
  </section>
  <div class="festival-strip" aria-label="Festival themes"><div class="wrap"><span>Telescopes</span><b aria-hidden="true">✦</b><span>Science</span><b aria-hidden="true">✦</b><span>Art & ideas</span><b aria-hidden="true">✦</b><span>Mountain skies</span><b aria-hidden="true">✦</b><span>Good company</span></div></div>
  <FestivalSchedule/>
  <section class="section paper-section home-intro">
    <div class="wrap intro-split"><div><span class="eyebrow">A Summit County Dark Sky Celebration</span><h2>Bring your curiosity.</h2></div><div class="intro-body"><p class="large">Learn the constellations, look through a telescope, explore the science, get inspired, create, and spend some time under Breckenridge’s sky.</p><a class="text-link" href="/about/">Meet the festival <Icon name="arrow" size={18}/></a></div></div>
    <div class="wrap">
      <section class="inline-callout" id="press" aria-labelledby="press-headline">
        <div>
          <span class="eyebrow">In the press · 5280 Magazine · <time datetime="2026-11-04">November 4, 2026</time></span>
          <h2 id="press-headline">11 Fun Things To Do in the Mountains This November</h2>
          <p>5280 included Breck Sky Fest in its November mountain events roundup, highlighting guided night hikes, telescope viewing, and a chance to talk with astronomers.</p>
        </div>
        <a class="button button-dark" href="https://5280.com/things-to-do-in-the-mountains/#astronomy-festival">Read the 5280 feature <Icon name="diagonal" size={18}/></a>
      </section>
    </div>
  </section>
  <section class="section paper-section program-preview" id="events"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">From sunshine to starlight</span><h2>Find your<br/>sky time.</h2></div><div class="section-aside"><p>Choose free community stargazing in Frisco or Breckenridge, or book a guided VIP evening at Beaver Run.</p><a class="text-link" href="/program/">Explore all experiences <Icon name="arrow" size={18}/></a></div></div><div class="experience-grid home-events">{['frisco-historic-park-stargazing','community-stargazing','vip-stargazing-beaver-run'].map(slug=>experiences.find(event=>event.slug===slug)!).map(event=><ExperienceCard event={event}/>)}</div><p class="photo-note">Photos show previous AstroTours programs.</p></div></section>
  <section class="section community-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">More ways to join in</span><h2>More to explore<br/>around the county.</h2></div><div class="section-aside"><p>Explore the festival with local artists, educators, and trail guides.</p></div></div><div class="possibilities-grid">{experiences.filter(e=>['full-moon-hike-with-pride','cosmic-creators-steam-saturday','create-among-the-stars','planet-walk'].includes(e.slug)).map(event=><a class:list={['possibility',`accent-${event.accent}`]} href={`/program/${event.slug}/`}><Icon name={event.icon} size={38}/><span class="status-label">{event.status}</span><h3>{event.title}</h3><span class="possibility-arrow" aria-hidden="true">↗</span></a>)}</div><div class="section-bottom"><p>Have an idea for a workshop, pop-up, talk, or local event?</p><a class="button button-outline" href="/get-involved/">Be part of the festival <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="section paper-section family-section" id="visit"><div class="wrap feature-split"><figure class="family-photo"><img src="/images/family-telescope.webp" alt="A family taking turns at a large telescope at dusk during an AstroTours program" width="1280" height="960" loading="lazy"/><figcaption>Real skies. Real curiosity. An AstroTours family session.</figcaption><span class="photo-sticker">Small world.<br/>Big universe.</span></figure><div><span class="eyebrow">Make a family adventure of it</span><h2>New to stargazing?<br/>Start here.</h2><p>Start with daytime science or a creative workshop, then look through a telescope after dark. First-time stargazers are welcome.</p><ul class="feature-list"><li><Icon name="sun"/>Daytime activities for curious kids and grown-ups</li><li><Icon name="stars"/>Astronomers who welcome every question</li><li><Icon name="ticket"/>Free community stargazing and ticketed events</li></ul><a href="/visit/" class="button button-dark">Start planning your visit <Icon name="arrow" size={20}/></a></div></div></section>
  <section class="visitor-ribbon"><div class="wrap"><div><span>01 / When</span><strong>November 2026</strong><p>November 11–30 · Main weekend November 27–28</p></div><div><span>02 / Where</span><strong>Summit County, CO</strong><p>Festival venues in Breckenridge and Frisco</p></div><div><span>03 / Registration</span><strong>Free stargazing</strong><p>Nov. 27 in Frisco · Nov. 28 in Breckenridge</p></div><a href="/visit/">The practical stuff <Icon name="arrow" size={25}/></a></div></section>
  <section class="section paper-section" id="partners"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">Helping Breck look up</span><h2>Our sponsors &amp; partners.</h2></div><a class="text-link" href="/sponsors/">Meet the supporters <Icon name="arrow" size={18}/></a></div><Sponsors compact/></div></section>
  <section class="section faq-preview paper-section"><div class="wrap faq-split"><div><span class="eyebrow">Before you pack the cocoa</span><h2>A few good<br/>questions.</h2><a class="text-link" href="/visit/#questions">All visitor questions <Icon name="arrow" size={18}/></a></div><div class="faq-list">{[faqs[0],faqs[1],faqs[2],faqs[5]].map(faq=><details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
  <Updates/>
</Layout>
