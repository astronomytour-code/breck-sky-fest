---
import Layout from '../../layouts/Layout.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import Icon from '../../components/Icon.astro';
import {experiences,emailLink} from '../../data/festival';
export function getStaticPaths(){return experiences.map(event=>({params:{slug:event.slug},props:{event}}));}
const {event}=Astro.props;
const related=experiences.filter(e=>e.slug!==event.slug).slice(0,3);
const isSignature=event.slug==='mountain-stargazing';
const isFreeCore=['community-stargazing','sky-day','sky-school'].includes(event.slug);
const registrationStatus=isSignature?'Registration coming soon through AstroTours. The booking link will appear here when registration opens.':isFreeCore?'Free program · final access details coming in October.':'Final participation details will be posted with the confirmed listing.';
---
<Layout title={`${event.title} | Breck Sky Fest`} description={`${event.summary} ${event.status}. Date, time, and venue TBA.`}>
  <section class:list={['detail-hero',`accent-${event.accent}`]}><div class="wrap"><a class="breadcrumb" href="/program/">← Program preview</a><div class="detail-hero-grid"><div><span class="eyebrow">{event.category} / {event.subtitle}</span><h1>{event.title}</h1><p class="lede">{event.summary}</p><span class="detail-status">{event.status}</span></div><div class="detail-picture">{event.image?<img src={`/images/${event.image}.webp`} alt={event.alt} width="1280" height="853" fetchpriority="high"/>:<div class="detail-art"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><Icon name={event.icon} size={150}/><span>Breck Sky Fest / 2026</span></div>}</div></div>{event.image&&<p class="photo-note light-note">Image shows a previous astronomy program. Festival venue and arrangements are still being confirmed.</p>}</div></section>
  <section class="section paper-section"><div class="wrap detail-layout"><article class="detail-main"><span class="eyebrow">The idea</span><h2>What to look forward to.</h2>{event.description.map(p=><p>{p}</p>)}<h3>What we’re planning</h3><ul class="check-list">{event.highlights.map(item=><li><Icon name="stars" size={18}/>{item}</li>)}</ul><div class="practical-note"><h3>Good to know</h3><p>{event.practical}</p></div><div class="opportunity-note"><span class="eyebrow">Help bring this to life</span><h3>There’s room to take part.</h3><p>{event.opportunity}</p><a href={emailLink(`Partner idea: ${event.title}`)} class="text-link">Talk to us about this experience <Icon name="arrow" size={18}/></a></div></article><aside class="event-facts"><span class="eyebrow">At a glance</span><dl><div><dt>Date</dt><dd>November 2026 · exact date TBA</dd></div><div><dt>Time</dt><dd>TBA</dd></div><div><dt>Venue</dt><dd>{event.venue || 'TBA · Breckenridge, Colorado'}</dd></div><div><dt>Who it’s for</dt><dd>{event.audience}</dd></div><div><dt>Admission</dt><dd>{event.admission}</dd></div><div><dt>Duration</dt><dd>{event.duration}</dd></div><div><dt>Access & facilities</dt><dd>Details to be published with the venue</dd></div></dl><p class="booking-status">{registrationStatus}</p><a class="button button-dark" href={emailLink(`Question about ${event.title}`)}>Ask about this event <Icon name="arrow" size={18}/></a><a class="text-link facts-visit" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a></aside></div></section>
  <section class="section paper-section related-section"><div class="wrap"><div class="section-heading"><h2>More to explore.</h2><a class="text-link" href="/program/">Full program preview <Icon name="arrow" size={18}/></a></div><div class="experience-grid">{related.map(e=><ExperienceCard event={e}/>)}</div></div></section>
</Layout>
