---
import Layout from '../../layouts/Layout.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import Icon from '../../components/Icon.astro';
import {experiences,emailLink} from '../../data/festival';
export function getStaticPaths(){return experiences.map(event=>({params:{slug:event.slug},props:{event}}));}
const {event}=Astro.props;
const related=experiences.filter(e=>e.slug!==event.slug && e.date && !e.past).slice(0,3);
const isBoecStargazing=event.slug==='accessible-astronomy-boec';
const isBoec=isBoecStargazing || event.slug==='boec-school-program';
const isFdrd=['full-moon-hike-with-pride','night-sky-hike-fdrd'].includes(event.slug);
const heroImageSize=isFdrd ? (event.slug==='full-moon-hike-with-pride' ? [540,360] : [1200,1600]) : [1280,853];
const isOtherWorlds=['reach-for-the-stars-storytime','cosmic-creators-steam-saturday'].includes(event.slug);
const isSchool=['sky-school','boec-school-program'].includes(event.slug);
const registrationBySlug: Record<string, string> = {
  'chelsea-kaiah-open-studio': 'Free drop-in open studio. See Breck Create for host information.',
  'bob-ross-style-painting-galaxies': 'Book directly with Breck Create.',
  'full-moon-hike-with-pride': 'Free and open to the public. Register directly with FDRD.',
  'night-sky-hike-fdrd': 'Register directly with FDRD and check the host’s arrival and equipment guidance.',
  'cosmic-creators-steam-saturday': 'Activities are included with exhibition admission. Walk-ins are welcome up to capacity.',
  'reach-for-the-stars-storytime': 'Get tickets through Breck Create. Walk-ins are welcome up to capacity.',
  'community-stargazing': 'Free RSVP required for attendance planning and weather updates.',
  'frisco-historic-park-stargazing': 'Free RSVP required. Drop in anytime from 5:30 to 7:30 PM.',
  'accessible-astronomy-boec': 'Registration is closed.',
  'wellness-under-the-sky': 'Choose the 4 PM or 6 PM session and book directly with Spirit Alchemy.',
  'create-among-the-stars': 'Book directly with Ready Paint Fire and choose Canvas or Mosaic.',
  'vip-stargazing-beaver-run': 'Select the November 28 Breckenridge tour at Beaver Run. Existing bookings include the festival extras at their original price.',
  'planet-walk': 'Route and timing are still being finalized.',
};
const registrationStatus = isSchool
  ? 'Participation is arranged through the schools.'
  : registrationBySlug[event.slug] ?? 'Reserve directly through AstroTours.';

---
<Layout title={`${event.title} | Breck Sky Fest`} description={`${event.summary} ${event.status}. ${event.date || "Date TBA"}. ${event.time || "Time TBA"}. ${event.venue || "Venue TBA"}.`}>
  <section class:list={['detail-hero',`accent-${event.accent}`]}><div class="wrap"><a class="breadcrumb" href="/program/">← Festival schedule</a><div class="detail-hero-grid"><div><span class="eyebrow">{event.category} / {event.subtitle}</span><h1>{event.title}</h1><p class="lede">{event.summary}</p><span class="detail-status">{event.status}</span>{isBoec&&<a class="boec-host-logo" href="https://www.boec.org/fifty/" target="_blank" rel="noopener noreferrer"><img src="/images/boec-50-white-horizontal.png" alt="Breckenridge Outdoor Education Center (BOEC), 50 years" width="1308" height="444"/></a>}</div><div class:list={["detail-picture", {"canvas-picture":event.slug==='create-among-the-stars',"fdrd-picture":isFdrd}]}>{event.image?<img src={`/images/${event.image}.webp`} alt={event.alt} width={heroImageSize[0]} height={heroImageSize[1]} fetchpriority="high"/>:<div class="detail-art"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><Icon name={event.icon} size={150}/><span>Breck Sky Fest / 2026</span></div>}</div></div>{event.image&&<p class="photo-note light-note">{isFdrd ? 'Image supplied by Friends of the Dillon Ranger District.' : event.slug==='wellness-under-the-sky' ? 'Photo courtesy of Spirit Alchemy Studio.' : event.slug==='create-among-the-stars' ? 'Canvas artwork image courtesy of Ready Paint Fire! Painting led by Brittney Issacs.' : 'Image shows a previous astronomy program.'}</p>}</div></section>
  <section class="section paper-section"><div class="wrap detail-layout"><article class="detail-main"><span class="eyebrow">{event.date ? "The program" : "The idea"}</span><h2>{event.past ? "About the event." : "What to look forward to."}</h2>{event.description.map(p=><p>{p}</p>)}{event.slug==='reach-for-the-stars-storytime'&&<p><a class="text-link" href="https://www.mountaintopbreck.org/visit" target="_blank" rel="noopener noreferrer">Plan your Mountain Top Explorium visit</a> with half-price day passes after Storytime. Just tell the team the story of the day!</p>}{isBoecStargazing&&<p><a class="text-link" href="/rsvp/frisco/">Free Frisco RSVP · November 27</a> · <a class="text-link" href="/program/community-stargazing/">Main Festival Stargazing · November 28</a></p>}{event.slug==='community-stargazing'&&<p><a class="text-link" href="/program/vip-stargazing-beaver-run/">Explore VIP Stargazing at Beaver Run · $57 per person</a>. A separate ticketed experience with early access, tea and coffee, and access to a warming area and fire.</p>}{event.slug==='create-among-the-stars'&&<figure class="mosaic-project"><img src="/images/ready-paint-fire-mosaic.webp" alt="Round glass mosaic with blue and purple pieces and pale glow-in-the-dark stars forming a constellation" width="1000" height="1000" loading="lazy" decoding="async"/><figcaption>Glow-in-the-dark constellation glass mosaic example, courtesy of Ready Paint Fire! Choose your star sign constellation when creating your project.</figcaption></figure>}<h3>{event.date ? "Program highlights" : "What we’re planning"}</h3><ul class="check-list">{event.highlights.map(item=><li><Icon name="stars" size={18}/>{item}</li>)}</ul><div class="practical-note"><h3>Good to know</h3><p>{event.practical}</p></div>{isBoec ? <div class="opportunity-note"><span class="eyebrow">Our program partner</span><h3>Breckenridge Outdoor Education Center (BOEC)</h3><p>Presented in partnership with BOEC, celebrating 50 years of outdoor education.</p><a href="https://www.boec.org/fifty/" target="_blank" rel="noopener noreferrer" class="text-link">Learn about BOEC’s 50 years <Icon name="arrow" size={18}/></a></div> : event.slug==='wellness-under-the-sky' ? <div class="opportunity-note"><span class="eyebrow">Your host</span><h3>Spirit Alchemy Studio</h3><p>{event.opportunity}</p><a href="https://www.instagram.com/spirit_alchemy_studio/" target="_blank" rel="noopener noreferrer" class="text-link">Meet Spirit Alchemy on Instagram</a></div> : event.slug==='create-among-the-stars' ? <div class="opportunity-note"><span class="eyebrow">Your host</span><h3>Ready Paint Fire!</h3><p>{event.opportunity}</p><a href="https://rpfbreck.com/" target="_blank" rel="noopener noreferrer" class="text-link">Visit the studio website</a></div> : isFdrd ? <div class="opportunity-note"><span class="eyebrow">Your program partners</span><h3>{event.slug==='full-moon-hike-with-pride' ? 'FDRD & Mountain Pride' : 'Friends of the Dillon Ranger District'}</h3><p>{event.opportunity}</p><a href="https://fdrd.org/" target="_blank" rel="noopener noreferrer" class="text-link">Visit Friends of the Dillon Ranger District</a><p><a href="mailto:maddie@fdrd.org" class="text-link">Contact FDRD about this hike</a></p></div> : isOtherWorlds ? <div class="opportunity-note"><span class="eyebrow">Your program partners</span><h3>Mountain Top Explorium &amp; Breck Create</h3><p>{event.opportunity}</p><a href="https://www.mountaintopbreck.org/" class="text-link" target="_blank" rel="noopener noreferrer">Visit Mountain Top Explorium</a><p><a href="https://breckcreate.org/arts-district/old-masonic-hall/" class="text-link" target="_blank" rel="noopener noreferrer">Explore Other Worlds at Old Masonic Hall</a></p></div> : <div class="opportunity-note"><span class="eyebrow">Event information</span><h3>Questions about this event?</h3><p>{event.opportunity}</p><a href={emailLink(`Question about ${event.title}`)} class="text-link">Contact the festival <Icon name="arrow" size={18}/></a></div>}</article><aside class="event-facts"><span class="eyebrow">At a glance</span><dl><div><dt>Date</dt><dd>{event.date || "November 2026 · exact date TBA"}</dd></div><div><dt>Time</dt><dd>{event.time || "To Be Announced"}</dd></div><div><dt>Venue</dt><dd>{event.venue || 'TBA · Breckenridge, Colorado'}</dd></div><div><dt>Who it’s for</dt><dd>{event.audience}</dd></div><div><dt>Admission</dt><dd>{event.admission}</dd></div><div><dt>Duration</dt><dd>{event.duration}</dd></div><div><dt>Access & facilities</dt><dd>{isFdrd ? 'Outdoor trail program. Contact FDRD about trail accessibility, conditions, and equipment requirements.' : isOtherWorlds ? 'Wheelchair accessible. Contact Mountain Top Explorium or Breck Create for further facility information.' : event.slug==='vip-stargazing-beaver-run' ? 'Warming area and fire access included; contact us about accessibility needs.' : event.slug==='create-among-the-stars' ? 'Contact Ready Paint Fire about studio accessibility and materials.' : isSchool ? 'Contact the school about student access.' : 'Contact the festival about access at this venue.'}</dd></div></dl><p class="booking-status">{registrationStatus}</p>{!event.past && <a class="button button-dark" href={event.ctaHref || emailLink(`Question about ${event.title}`)}>{event.ctaLabel || "Ask about this event"}</a>}<a class="text-link facts-visit" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a></aside></div></section>
  <section class="section paper-section related-section"><div class="wrap"><div class="section-heading"><h2>More to explore.</h2><a class="text-link" href="/program/">Full festival program <Icon name="arrow" size={18}/></a></div><div class="experience-grid">{related.map(e=><ExperienceCard event={e}/>)}</div></div></section>
</Layout>

<style>
  .fdrd-picture{height:auto;width:100%;max-width:540px;justify-self:center;border-radius:5px}
  .fdrd-picture>img{display:block;width:100%;height:auto;object-fit:contain}

  .mosaic-project{margin:32px 0}
  .mosaic-project img{display:block;width:100%;height:auto;border-radius:5px}
  .mosaic-project figcaption{font-size:.8rem;line-height:1.5;color:var(--muted);margin-top:12px}

  .canvas-picture{height:auto;max-width:100%;border-radius:5px}
  .canvas-picture>img{display:block;width:100%;height:auto;object-fit:contain}

  .boec-host-logo{display:block;width:min(100%,320px);margin-top:28px;padding:16px;background:var(--ink);border-radius:4px}
  .boec-host-logo img{display:block;width:100%;height:auto;object-fit:contain}
</style>
