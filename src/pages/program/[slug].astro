---
import Layout from '../../layouts/Layout.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import Icon from '../../components/Icon.astro';
import {experiences,emailLink} from '../../data/festival';
export function getStaticPaths(){return experiences.map(event=>({params:{slug:event.slug},props:{event}}));}
const {event}=Astro.props;
const related=experiences.filter(e=>e.slug!==event.slug).slice(0,3);
const isBoec=['accessible-astronomy-boec','boec-school-program'].includes(event.slug);
const isOtherWorlds=['reach-for-the-stars-storytime','cosmic-creators-steam-saturday'].includes(event.slug);
const isSignature=event.slug==='mountain-stargazing';
const isFreeCore=['community-stargazing','sky-day','sky-school'].includes(event.slug);
const registrationStatus=event.ctaHref ? (isOtherWorlds ? (event.slug==='cosmic-creators-steam-saturday' ? 'Saturday, November 28, 10 AM–1 PM MST. Activities are included with exhibition admission. Walk-ins welcome up to capacity. Direct host ticket link coming soon; explore the exhibition information below.' : 'Wednesday, November 25, 10:30–11:30 AM MST. Purchase tickets through Breck Create or walk in, subject to capacity. Half-price Mountain Top Explorium day passes are available after Storytime: just tell the team the story of the day!') : event.slug==='community-stargazing' ? 'Free · $0. RSVP required for attendance planning and important weather updates. Daytime solar astronomy time: To Be Announced. Evening stargazing: 6:00–7:30 PM MST.' : event.slug==='frisco-historic-park-stargazing' ? 'Free · $0. RSVP required so we can plan enough equipment for everyone and send important weather updates. Drop in anytime between 5:30 and 7:30 PM.' : event.slug==='accessible-astronomy-boec' ? 'RSVP for public evening stargazing and share accessibility needs. Evening program: 5:30–7:00 PM MST. Location: To Be Announced.' : event.slug==='wellness-under-the-sky' ? 'Choose the 4 PM or 6 PM session and book directly with Spirit Alchemy. $40 per person. Check the studio booking page for availability.' : event.slug==='create-among-the-stars' ? 'Choose Canvas or Mosaic when booking through Ready Paint Fire. $35 per participant/project, including all supplies and equipment. Arrive at noon for 12:15 PM instruction. Direct booking link expected by October 19.' : event.slug==='vip-stargazing-beaver-run' ? '$57 per person · limited to 22 guests. Select the November 28 Breckenridge tour at Beaver Run. Existing bookings include the festival extras at their original price.' : 'Reserve directly through AstroTours for booking details.') : event.date ? 'Additional details coming soon. Please check back for the full program.' : isSignature?'Registration coming soon through AstroTours. The booking link will appear here when registration opens.':isFreeCore?'Free program · final access details coming in October.':'Final participation details will be posted with the confirmed listing.';
---
<Layout title={`${event.title} | Breck Sky Fest`} description={`${event.summary} ${event.status}. ${event.date || "Date TBA"}. ${event.time || "Time TBA"}. ${event.venue || "Venue TBA"}.`}>
  <section class:list={['detail-hero',`accent-${event.accent}`]}><div class="wrap"><a class="breadcrumb" href="/program/">← Festival schedule</a><div class="detail-hero-grid"><div><span class="eyebrow">{event.category} / {event.subtitle}</span><h1>{event.title}</h1><p class="lede">{event.summary}</p><span class="detail-status">{event.status}</span>{isBoec&&<a class="boec-host-logo" href="https://www.boec.org/fifty/" target="_blank" rel="noopener noreferrer"><img src="/images/boec-50-white-horizontal.png" alt="Breckenridge Outdoor Education Center (BOEC), 50 years" width="1308" height="444"/></a>}</div><div class:list={["detail-picture", {"canvas-picture":event.slug==='create-among-the-stars'}]}>{event.image?<img src={`/images/${event.image}.webp`} alt={event.alt} width="1280" height="853" fetchpriority="high"/>:<div class="detail-art"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><Icon name={event.icon} size={150}/><span>Breck Sky Fest / 2026</span></div>}</div></div>{event.image&&<p class="photo-note light-note">{event.slug==='wellness-under-the-sky' ? 'Photo courtesy of Spirit Alchemy Studio.' : event.slug==='create-among-the-stars' ? 'Canvas artwork image courtesy of Ready Paint Fire! Painting led by Brittney Issacs.' : 'Image shows a previous astronomy program. Festival venue and arrangements are still being confirmed.'}</p>}</div></section>
  <section class="section paper-section"><div class="wrap detail-layout"><article class="detail-main"><span class="eyebrow">{event.date ? "The program" : "The idea"}</span><h2>What to look forward to.</h2>{event.description.map(p=><p>{p}</p>)}{event.slug==='reach-for-the-stars-storytime'&&<p><a class="text-link" href="https://www.mountaintopbreck.org/visit" target="_blank" rel="noopener noreferrer">Plan your Mountain Top Explorium visit</a> with half-price day passes after Storytime. Just tell the team the story of the day!</p>}<p>{event.slug==='accessible-astronomy-boec'&&<><a class="text-link" href="/rsvp/frisco/">Free Frisco RSVP · November 27</a> · <a class="text-link" href="/program/community-stargazing/">Main Breck program · November 28</a></>}</p>{event.slug==='community-stargazing'&&<p><a class="text-link" href="/program/vip-stargazing-beaver-run/">Explore VIP Stargazing at Beaver Run · $57 per person</a>. A separate ticketed experience with early access, tea and coffee, and access to a warming area and fire.</p>}{event.slug==='create-among-the-stars'&&<figure class="mosaic-project"><img src="/images/ready-paint-fire-mosaic.webp" alt="Round glass mosaic with blue and purple pieces and pale glow-in-the-dark stars forming a constellation" width="1000" height="1000" loading="lazy" decoding="async"/><figcaption>Glow-in-the-dark constellation glass mosaic example, courtesy of Ready Paint Fire! Choose your star sign constellation when creating your project.</figcaption></figure>}<h3>{event.date ? "Program highlights" : "What we’re planning"}</h3><ul class="check-list">{event.highlights.map(item=><li><Icon name="stars" size={18}/>{item}</li>)}</ul><div class="practical-note"><h3>Good to know</h3><p>{event.practical}</p></div>{isBoec ? <div class="opportunity-note"><span class="eyebrow">Our program partner</span><h3>Breckenridge Outdoor Education Center (BOEC)</h3><p>Presented in partnership with BOEC, celebrating 50 years of outdoor education.</p><a href="https://www.boec.org/fifty/" target="_blank" rel="noopener noreferrer" class="text-link">Learn about BOEC’s 50 years <Icon name="arrow" size={18}/></a></div> : event.slug==='wellness-under-the-sky' ? <div class="opportunity-note"><span class="eyebrow">Your host</span><h3>Spirit Alchemy Studio</h3><p>{event.opportunity}</p><a href="https://www.instagram.com/spirit_alchemy_studio/" target="_blank" rel="noopener noreferrer" class="text-link">Meet Spirit Alchemy on Instagram</a></div> : event.slug==='create-among-the-stars' ? <div class="opportunity-note"><span class="eyebrow">Your host</span><h3>Ready Paint Fire!</h3><p>{event.opportunity}</p><a href="https://rpfbreck.com/" target="_blank" rel="noopener noreferrer" class="text-link">Visit the studio website</a></div> : isOtherWorlds ? <div class="opportunity-note"><span class="eyebrow">Your program partners</span><h3>Mountain Top Explorium &amp; Breck Create</h3><p>{event.opportunity}</p><a href="https://www.mountaintopbreck.org/" class="text-link" target="_blank" rel="noopener noreferrer">Visit Mountain Top Explorium</a><p><a href="https://breckcreate.org/arts-district/old-masonic-hall/" class="text-link" target="_blank" rel="noopener noreferrer">Explore Other Worlds at Old Masonic Hall</a></p></div> : <div class="opportunity-note"><span class="eyebrow">Help bring this to life</span><h3>There’s room to take part.</h3><p>{event.opportunity}</p><a href={emailLink(`Partner idea: ${event.title}`)} class="text-link">Talk to us about this experience <Icon name="arrow" size={18}/></a></div>}</article><aside class="event-facts"><span class="eyebrow">At a glance</span><dl><div><dt>Date</dt><dd>{event.date || "November 2026 · exact date TBA"}</dd></div><div><dt>Time</dt><dd>{event.time || "To Be Announced"}</dd></div><div><dt>Venue</dt><dd>{event.venue || 'TBA · Breckenridge, Colorado'}</dd></div><div><dt>Who it’s for</dt><dd>{event.audience}</dd></div><div><dt>Admission</dt><dd>{event.admission}</dd></div><div><dt>Duration</dt><dd>{event.duration}</dd></div><div><dt>Access & facilities</dt><dd>{isOtherWorlds ? 'Wheelchair accessible. Contact Mountain Top Explorium or Breck Create for further facility information.' : event.slug==='vip-stargazing-beaver-run' ? 'Warming area and fire access included; contact us about accessibility needs.' : event.slug==='create-among-the-stars' ? 'Contact Ready Paint Fire about studio accessibility and materials.' : 'Details to be published with the venue'}</dd></div></dl><p class="booking-status">{registrationStatus}</p><a class="button button-dark" href={event.ctaHref || emailLink(`Question about ${event.title}`)}>{event.ctaLabel || "Ask about this event"}</a><a class="text-link facts-visit" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a></aside></div></section>
  <section class="section paper-section related-section"><div class="wrap"><div class="section-heading"><h2>More to explore.</h2><a class="text-link" href="/program/">Full festival program <Icon name="arrow" size={18}/></a></div><div class="experience-grid">{related.map(e=><ExperienceCard event={e}/>)}</div></div></section>
</Layout>

<style>
  .mosaic-project{margin:32px 0}
  .mosaic-project img{display:block;width:100%;height:auto;border-radius:5px}
  .mosaic-project figcaption{font-size:.8rem;line-height:1.5;color:var(--muted);margin-top:12px}

  .canvas-picture{height:auto;max-width:100%;border-radius:5px}
  .canvas-picture>img{display:block;width:100%;height:auto;object-fit:contain}

  .boec-host-logo{display:block;width:min(100%,320px);margin-top:28px;padding:16px;background:var(--ink);border-radius:4px}
  .boec-host-logo img{display:block;width:100%;height:auto;object-fit:contain}
</style>
