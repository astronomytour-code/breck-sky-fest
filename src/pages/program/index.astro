---
import FestivalSchedule from '../../components/FestivalSchedule.astro';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Updates from '../../components/Updates.astro';
import Icon from '../../components/Icon.astro';
---
<Layout title="Festival Schedule & Program | Breck Sky Fest" description="Find November 2026 Breck Sky Fest events in Breckenridge and Frisco, including free stargazing, guided hikes, art workshops, and family science.">
  <PageIntro eyebrow="The 2026 festival program" title="A little wonder. Day and night." description="Find telescope nights, art workshops, guided hikes, and hands-on science across Breckenridge and Frisco." icon="sun"/>
  <FestivalSchedule/>
  <section class="section paper-section"><div class="wrap">
    <div class="inline-callout">
      <div><span class="eyebrow">Route and timing TBA</span><h2>Planet Walk</h2><p>Explore the scale of the Solar System on a self-guided route being planned for Breckenridge and Frisco.</p></div>
      <a class="button button-dark" href="/program/planet-walk/">Planet Walk details <Icon name="arrow" size={20}/></a>
    </div>
  </div></section>
  <Updates/>
</Layout>
