---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {festival} from '../data/festival';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const {title='Breckenridge Sky Festival | Astronomy & Dark-Sky Festival', description=festival.description, image='/images/mountain-stars.webp', noindex=false} = Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,Astro.site);
const nav=[['Program','/program/'],['Plan your visit','/visit/'],['Get involved','/get-involved/'],['Sponsors','/sponsors/']];
const current=(url:string)=>path===url||(url==='/program/'&&path.startsWith('/program/'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#141d2a"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    {noindex && <meta name="robots" content="noindex"/>}
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Breckenridge Sky Festival"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={new URL(image,Astro.site)}/>
    <meta property="og:image:alt" content="A telescope under a mountain night sky"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Breckenridge Sky Festival',url:Astro.site?.toString(),description:festival.description,inLanguage:'en-US'})}/>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="announcement"><div class="wrap"><span>Breckenridge, Colorado <span class="announcement-dot">✦</span> November 2026</span><a href="/visit/#dates">Final details posted in October <span aria-hidden="true">↗</span></a></div></div>
    <header class="site-header">
      <div class="wrap nav-wrap">
        <a class="brand" href="/" aria-label="Breck Sky Fest home"><Icon name="stars" size={34}/><span>BRECK<span>SKY FEST</span></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={current(url)?'page':undefined}>{label}</a>)}</nav>
        <a class="nav-contact" href="/contact/">Say hello <Icon name="diagonal" size={18}/></a>
        <details class="mobile-menu"><summary aria-label="Open navigation menu">Menu <span class="menu-lines" aria-hidden="true"></span></summary><nav aria-label="Mobile navigation">{nav.map(([label,url])=><a href={url} aria-current={current(url)?'page':undefined}>{label}</a>)}<a href="/about/">About the festival</a><a href="/gallery/">Photo gallery</a><a href="/contact/">Say hello</a></nav></details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer"><div class="wrap">
      <div class="footer-top"><div class="footer-brand"><a class="brand" href="/"><Icon name="stars" size={36}/><span>BRECK<span>SKY FEST</span></span></a><p>Breckenridge’s astronomy<br/>and dark-sky festival.</p><span class="footer-date">November 2026 · Dates TBA</span></div>
        <div><h2>Come explore</h2><a href="/program/">Program preview</a><a href="/visit/">Plan your visit</a><a href="/visit/#questions">Frequently asked questions</a><a href="/gallery/">Photo gallery</a></div>
        <div><h2>Be part of it</h2><a href="/get-involved/">Get involved</a><a href="/sponsors/">Sponsors</a><a href="/get-involved/#schools">Schools & youth groups</a><a href="/get-involved/#groups">Groups & private events</a></div>
        <div><h2>Let’s talk</h2><a href="/about/">About the festival</a><a href="/contact/">Contact</a><a href={`mailto:${festival.email}`} class="footer-email">{festival.email}</a><p class="small">We prefer email as it keeps us organised.</p></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Breckenridge Sky Festival · Organized by AstroTours.org</span><span>First festival in development. Program subject to confirmation. · <a href="https://www.astrotours.org/" target="_blank" rel="noopener noreferrer">Photo credits: AstroTours.org</a></span></div>
    </div></footer>
    <script>
      const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
      document.addEventListener('click',(event)=>{if(menu?.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});
    </script>
  </body>
</html>
